{
  "name": "@vamo-virar/design-system",
  "version": "0.1.0",
  "description": "Vamo Virar design system: colour, type and motion tokens, brand marks and UI components for React Native (web via react-native-web), for the web (Radix + Tailwind CSS), and every shadcn/ui component in the campaign's style.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugobessa/vamo-virar-design-system.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./web/styles.css": "./dist/web/styles.css",
    "./web/theme.css": "./dist/web/theme.css",
    "./shadcn/*": {
      "types": "./dist/shadcn/*.d.ts",
      "default": "./dist/shadcn/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/stories",
    "!src/**/*.test.ts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/web/theme.css dist/web/theme.css && tailwindcss -i src/web/styles.css -o dist/web/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist-storybook",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "~1.49.0",
    "radix-ui": "~1.6.7",
    "tailwind-merge": "~3.7.0",
    "tw-animate-css": "~1.4.0"
  },
  "peerDependencies": {
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "expo-haptics": "*",
    "input-otp": "^1.5.0",
    "react": ">=19",
    "react-day-picker": "^9.14.0",
    "react-dom": ">=19",
    "react-hook-form": "^7.89.0",
    "react-native": ">=0.79",
    "react-native-safe-area-context": ">=5",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "input-otp": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "vaul": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-native-web-vite": "^10.6.1",
    "@tailwindcss/cli": "~4.3.3",
    "@tailwindcss/vite": "~4.3.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "cmdk": "~1.1.1",
    "embla-carousel-react": "~8.6.0",
    "expo-haptics": "~57.0.3",
    "input-otp": "~1.5.0",
    "react": "19.2.3",
    "react-day-picker": "~9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "~7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-resizable-panels": "~3.0.6",
    "recharts": "~3.10.1",
    "sonner": "~2.0.8",
    "storybook": "^10.6.1",
    "tailwindcss": "~4.3.3",
    "typescript": "~5.9.3",
    "vaul": "~1.1.2",
    "vite": "^7.3.7",
    "vitest": "3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
