{
  "name": "@vamo-virar/design-system",
  "version": "0.1.0",
  "description": "Vamo Virar design system: colour, type and motion tokens, brand marks and React Native components (web via react-native-web).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugobessa/vamo-virar-design-system.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/stories",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist-storybook",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "expo-haptics": "*",
    "react": ">=19",
    "react-native": ">=0.79",
    "react-native-safe-area-context": ">=5"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-native-web-vite": "^10.6.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "expo-haptics": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "storybook": "^10.6.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
